{
  "name": "docs-system-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentación técnica — React SPA of the technical documentation management system.",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "contract:sync": "node scripts/sync-contract.mjs",
    "contract:types": "openapi-typescript contract/openapi.yaml -o src/api/schema.d.ts",
    "contract:check": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "yaml": "2.9.1"
  }
}
